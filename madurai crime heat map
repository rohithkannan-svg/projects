      </div>

      <div id="pickBanner" class="hidden absolute top-3 left-1/2 -translate-x-1/2 z-[600] glass rounded-full px-4 py-2 text-[12.5px] items-center gap-2">
        <i data-lucide="crosshair" class="w-4 h-4" style="color:var(--brand)"></i>
        Tap the spot on the map to place your report
        <button id="pickCancel" class="ml-1 text-slate-400 hover:text-white"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
      </div>

      <div id="toast" class="hidden absolute bottom-6 left-1/2 -translate-x-1/2 z-[700] glass rounded-xl px-4 py-2.5 text-[13px] items-center gap-2"></div>
    </main>

    <aside id="drawer" class="panel glass flex-col border-l hidden" style="border-left-color:var(--hair)">
      <div id="drawerBody" class="scroll flex-1 overflow-y-auto"></div>
    </aside>

    <div id="scrim" class="hidden lg:hidden absolute inset-0 z-[35] bg-black/50 backdrop-blur-[2px]"></div>
  </div>
</div>

<!-- ══ REPORT MODAL ══ -->
<div id="reportModal" class="hidden fixed inset-0 z-[900] items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
  <div class="glass rounded-2xl w-full max-w-md overflow-hidden" role="dialog" aria-modal="true" aria-labelledby="reportTitle">
    <div class="flex items-center justify-between px-5 py-3.5 border-b" style="border-bottom-color:var(--hair)">
