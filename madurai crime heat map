      <span class="dot" style="background:${col};box-shadow:0 0 0 3px ${col}22"></span>
      <span class="flex-1 truncate text-slate-200">${escHtml(z.name)}</span>
      ${al?`<span class="text-[10px] px-1.5 rounded-full" style="background:rgba(245,158,11,.18);color:#FBBF24">${al}</span>`:''}
      ${drop>0.05?`<i data-lucide="trending-down" class="w-3 h-3" style="color:var(--risk)"></i>`:''}
      <span class="text-[11.5px] font-semibold" style="color:${col}">${s.toFixed(1)}</span></button>`;
  }).join('');
  zoneList.querySelectorAll('[data-zone]').forEach(b=> b.onclick=()=>{
    openZone(b.dataset.zone); if(window.innerWidth<1024) closeSidebarFn();
  });
  icons();
}

function renderFeed(){
  const live = state.reports.filter(r=>decay.score(r)>0).sort((a,b)=>b.created_at-a.created_at);
  $('reportCount').textContent = live.length ? `${live.length} in 7 days` : '';
  if(!live.length){ feed.innerHTML = note('No reports yet. Use “Report an issue” to flag something you have seen.'); return; }
  feed.innerHTML = live.slice(0,6).map(r=>{
    const col = (r.severity||2)>=3?'var(--risk)':(r.severity||2)===2?'var(--warn)':'var(--brand)';
    const faded = decay.heat(r)===0;
    return `<button class="chip" data-rep="${r.id}" style="${faded?'opacity:.55':''}">
      <span class="dot" style="background:${col};box-shadow:0 0 0 3px ${col}22"></span>
      <span class="flex-1 min-w-0">
        <span class="block truncate text-slate-200">${escHtml(r.category)}</span>
        <span class="block truncate text-[11px] text-slate-500">${escHtml(byId[r.locality]?byId[r.locality].name:'Madurai')} · ${ago(r.created_at)}${faded?' · cooled off':''}</span>
      </span></button>`;
  }).join('');
  feed.querySelectorAll('[data-rep]').forEach(b=> b.onclick=()=>{
    const r = state.reports.find(x=>String(x.id)===b.dataset.rep);
    if(!r) return;
    map.flyTo([r.latitude,r.longitude],15,{duration:.7});
    if(window.innerWidth<1024) closeSidebarFn();
  });
}

function renderAlerts(){
  feeds.prune();
  if(!state.alerts.length){ alertFeed.innerHTML = note('Monitoring traffic and police feeds for the zones you have open.'); return; }
  alertFeed.innerHTML = state.alerts.slice(0,5).map(a=>`
    <button class="chip" data-alert="${a.zone}">
      <i data-lucide="${feeds.ICON[a.kind]}" class="w-3.5 h-3.5 flex-none" style="color:var(--warn)"></i>
      <span class="flex-1 min-w-0">
        <span class="block truncate text-slate-200">${escHtml(a.text)}</span>
        <span class="block truncate text-[11px] text-slate-500">${escHtml(byId[a.zone]?byId[a.zone].name:a.zone)} · ${ago(a.t)}</span>
      </span></button>`).join('');
  alertFeed.querySelectorAll('[data-alert]').forEach(b=> b.onclick=()=>{
    openZone(b.dataset.alert); if(window.innerWidth<1024) closeSidebarFn();
  });
  icons();
}

function ago(t){
  const m=Math.round((Date.now()-t)/60000);
  if(m<1) return 'just now';
  if(m<60) return `${m} min ago`;
  const h=Math.round(m/60);
  return h<24 ? `${h} hr ago` : `${Math.round(h/24)} d ago`;
}
function relFuture(t){
  const m=Math.round((t-Date.now())/60000);
  if(m<=0) return 'now';
  if(m<60) return `in ${m} min`;
  return `in ${Math.round(m/60)} hr`;
}
const escHtml = s => String(s).replace(/[<>&"]/g, c=>({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));

/* Lucide is optional-safe: never throw if the CDN is blocked. */
function icons(){ try { window.lucide && lucide.createIcons(); } catch(e){} }

/* ═══ 10. CONTROLS ═══════════════════════════════════════════════════════ */
const $ = id => document.getElementById(id);
let sidebar, drawer, drawerBody, scrim, fromSel, toSel, routeResult, zoneList, feed, alertFeed,
    reportModal, pickBanner, toastEl;

function bindUI(){
  sidebar=$('sidebar'); drawer=$('drawer'); drawerBody=$('drawerBody'); scrim=$('scrim');
  fromSel=$('fromSel'); toSel=$('toSel'); routeResult=$('routeResult'); zoneList=$('zoneList');
  feed=$('feed'); alertFeed=$('alertFeed'); reportModal=$('reportModal');
  pickBanner=$('pickBanner'); toastEl=$('toast');

  const opts = ZONES.map(z=>`<option value="${z.id}">${escHtml(z.name)}</option>`).join('');
  fromSel.innerHTML=opts; toSel.innerHTML=opts; $('rZone').innerHTML=opts;
  fromSel.value='junction'; toSel.value='othakadai';

  $('timeSeg').querySelectorAll('button').forEach(b=> b.onclick = ()=>{
    state.timePref = b.dataset.time;
    applyTimeMode(true);
  });

  document.querySelectorAll('[data-layer]').forEach(b=> b.onclick = ()=>{
    const k=b.dataset.layer; state.layers[k]=!state.layers[k];
    b.setAttribute('aria-pressed', state.layers[k]); refresh();
  });
  document.querySelectorAll('[data-cat]').forEach(b=> b.onclick = ()=>{
    const k=b.dataset.cat; state.cats[k]=!state.cats[k];
    b.setAttribute('aria-pressed', state.cats[k]); drawHeat();
  });
  $('sevSeg').querySelectorAll('button').forEach(b=> b.onclick = ()=>{
    state.severity = +b.dataset.sev;
    $('sevSeg').querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed', x===b));
  });

  $('btnRoute').onclick = findRoutes;
  $('btnClearRoute').onclick = ()=>{ routeLayer.clearLayers(); routeResult.innerHTML=''; };

  $('btnSidebar').onclick = openSidebarFn;
  $('closeSidebar').onclick = closeSidebarFn;
  scrim.onclick = ()=>{ closeSidebarFn(); closeDrawer(); };

  $('btnReport').onclick = openReport;
  $('closeReport').onclick = closeReportFn;
  $('cancelReport').onclick = closeReportFn;
  $('btnPick').onclick = startPick;
  $('pickCancel').onclick = cancelPick;
  $('reportForm').onsubmit = submitReport;

  document.addEventListener('keydown', e=>{
    if(e.key!=='Escape') return;
    if(state.picking) return cancelPick();
    if(!reportModal.classList.contains('hidden')) return closeReportFn();
    if(drawer.classList.contains('open')) return closeDrawer();
    closeSidebarFn();
  });
}

function applyTimeMode(userAction){
  const resolved = state.timePref==='auto' ? autoMode() : state.timePref;
  const changed = resolved !== state.time;
  state.time = resolved;
  $('timeSeg').querySelectorAll('button').forEach(x=>{
    const d=x.dataset.time;
    x.setAttribute('aria-pressed', d===state.timePref || (state.timePref==='auto' && d===resolved));
  });
  $('modeLabel').textContent = state.time==='day' ? 'Day map' : 'Night map';
  $('timeNote').textContent = state.timePref==='auto'
    ? `Following Madurai local time — currently ${istNow().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',hour12:true})}, so the ${state.time==='day'?'daytime':'after-dark'} weighting is on.`
    : state.time==='day'
      ? 'Daytime ratings assume normal footfall and open shops.'
      : 'Night ratings drop hardest on isolated outer roads and ring-road stretches.';
  if(changed || userAction){
    refresh();
    if(state.active) openZone(state.active, true);
    if(routeLayer && routeLayer.getLayers().length) findRoutes();
  }
}

function openSidebarFn(){ sidebar.classList.add('open'); scrim.classList.remove('hidden'); }
function closeSidebarFn(){ sidebar.classList.remove('open'); if(!drawer.classList.contains('open')) scrim.classList.add('hidden'); }

function openReport(){ reportModal.classList.remove('hidden'); reportModal.classList.add('flex'); icons(); }
function closeReportFn(){ reportModal.classList.add('hidden'); reportModal.classList.remove('flex'); }
function startPick(){
  state.picking=true; closeReportFn();
  pickBanner.classList.remove('hidden'); pickBanner.classList.add('flex');
  map.getContainer().style.cursor='crosshair';
}
function cancelPick(){
  state.picking=false;
  pickBanner.classList.add('hidden'); pickBanner.classList.remove('flex');
  map.getContainer().style.cursor='';
  openReport();
}

async function submitReport(e){
  e.preventDefault();
  const lat=parseFloat($('rLat').value), lng=parseFloat($('rLng').value);
  if(Number.isNaN(lat)||Number.isNaN(lng)){ toast('Add a location before submitting'); return; }

  const btn=$('rSubmit'); btn.disabled=true; btn.style.opacity=.6;
  const report = {
    id: 'local-'+Date.now()+'-'+Math.random().toString(36).slice(2,7),
    created_at: Date.now(),
    locality: $('rZone').value,
    latitude: lat, longitude: lng,
    category: $('rType').value,
    description: $('rNote').value.trim(),
    severity: state.severity
  };

  const res = await sync.insert(report);
  btn.disabled=false; btn.style.opacity=1;

  if(!res.ok){
    toast('Could not save that report — check your connection');
    console.warn('[sync] insert failed:', res.error);
    return;
  }
  if(res.echo) addReport(res.row, true);   // local mode: no realtime echo, add it ourselves

  e.target.reset(); $('rLat').value=''; $('rLng').value='';
  state.severity=2;
  $('sevSeg').querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed', x.dataset.sev==='2'));
  closeReportFn();

  state.layers.reports = true;
  document.querySelector('[data-layer="reports"]').setAttribute('aria-pressed','true');
  map.flyTo([lat,lng],15,{duration:.7});
  toast('Report submitted — thanks for flagging it');
}

/* A report arriving from anywhere: our own insert, another tab, or another user */
function addReport(row, mine){
  if(state.reports.some(r=>String(r.id)===String(row.id))) return;
  state.reports.unshift(row);

  if(state.layers.reports && reportLayer){
    reportLayer.addLayer(reportMarker(row, true));   // animated drop
    icons();
  }
  drawHeat(); drawZones(); renderZoneList(); renderFeed();
  if(state.active) openZone(state.active, true);
  if(!mine){
    toast(`New report nearby: ${row.category}`);
  }
}

/* Toast */
let toastTimer;
function toast(msg){
  toastEl.innerHTML = `<i data-lucide="check-circle-2" class="w-4 h-4" style="color:var(--safe)"></i><span>${escHtml(msg)}</span>`;
  toastEl.classList.remove('hidden'); toastEl.classList.add('flex'); icons();
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>{ toastEl.classList.add('hidden'); toastEl.classList.remove('flex'); },2800);
}

/* ═══ 11. REFRESH + BOOT ═════════════════════════════════════════════════ */
function refresh(){
  if(!map) return;
  state.layers.zones   ? zoneLayer.addTo(map)   : map.removeLayer(zoneLayer);
  state.layers.labels  ? labelLayer.addTo(map)  : map.removeLayer(labelLayer);
  state.layers.havens  ? havenLayer.addTo(map)  : map.removeLayer(havenLayer);
  state.layers.reports ? reportLayer.addTo(map) : map.removeLayer(reportLayer);
  drawZones(); drawHeat(); drawHavens(); drawReports(); renderZoneList(); renderFeed();
}

/* Every minute: re-apply decay, prune expired heat, re-check day/night */
function tick(){
  $('clock').textContent = istNow().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',hour12:true}) + ' IST';
  applyTimeMode(false);
  drawHeat(); drawReports(); drawZones(); renderZoneList(); renderFeed(); renderAlerts();
}

async function boot(){
  if(typeof L === 'undefined'){
    document.getElementById('map').innerHTML =
      '<div style="display:grid;place-items:center;height:100%;color:#8FA3B5;font-size:13px;padding:2rem;text-align:center">' +
      'Leaflet could not load from the CDN. Check the network connection and reload.</div>';
    return;
  }
  bindUI();
  initMap();
  applyTimeMode(false);
  refresh();
  icons();

  feeds.start();

  const rows = await sync.start(row => addReport(row, false));
  state.reports = rows;
  refresh();

  tick();
  setInterval(tick, CONFIG.tickMs);

  if(state.timePref==='auto' && state.time==='night'){
    setTimeout(()=>toast('It is after dark in Madurai — night weighting is on'), 900);
  }
}

if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
else boot();
</script>
