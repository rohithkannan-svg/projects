<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Madurai Safety &amp; Crime Heatmap Navigator</title>
<meta name="description" content="Live safety zones, decaying crime heat and safer routing for Madurai city and its outer belts." />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<!-- Leaflet core + heat plugin -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.heat/0.2.0/leaflet-heat.js"></script>

<!-- Supabase JS v2 (UMD build → window.supabase) -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>

<!-- Tailwind + Lucide -->
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lucide/0.454.0/umd/lucide.min.js"></script>
<script>
  window.tailwind && (tailwind.config = {
    theme:{ extend:{
      colors:{ ink:{900:'#0A0F14',800:'#0E151C',700:'#141D26',600:'#1B2733'},
               safe:'#10B981', warn:'#F59E0B', risk:'#EF4444', brand:'#22D3EE' },
      fontFamily:{ display:['"Bricolage Grotesque"','system-ui','sans-serif'], sans:['Inter','system-ui','sans-serif'] }
    }}
  });
</script>

<style>
  :root{
    --safe:#10B981; --warn:#F59E0B; --risk:#EF4444; --brand:#22D3EE;
    --glass:rgba(20,29,38,.72); --hair:rgba(148,183,209,.16);
  }
  html,body{height:100%}
  body{margin:0;background:#0A0F14;color:#E6EDF3;font-family:Inter,system-ui,sans-serif;overflow:hidden;-webkit-font-smoothing:antialiased}
  body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
    background:radial-gradient(60rem 30rem at 12% -10%,rgba(34,211,238,.10),transparent 60%),
               radial-gradient(50rem 28rem at 100% 110%,rgba(239,68,68,.08),transparent 60%);}
  .glass{background:var(--glass);backdrop-filter:blur(16px) saturate(140%);-webkit-backdrop-filter:blur(16px) saturate(140%);border:1px solid var(--hair)}
  .hair{border-color:var(--hair)}

  #map{position:absolute;inset:0;background:#0A0F14;z-index:0}
  .leaflet-container{background:#0A0F14;font-family:Inter,system-ui,sans-serif}
  .leaflet-tile-pane{filter:invert(1) hue-rotate(185deg) brightness(.82) contrast(1.05) saturate(.55)}
  .leaflet-control-zoom a{background:var(--glass)!important;color:#E6EDF3!important;border-color:var(--hair)!important;backdrop-filter:blur(12px)}
  .leaflet-control-zoom a:hover{background:#1B2733!important}
  .leaflet-control-attribution{background:rgba(10,15,20,.75)!important;color:#7b8a99!important;font-size:10px}
  .leaflet-control-attribution a{color:#9fb3c4!important}
  .leaflet-popup-content-wrapper,.leaflet-popup-tip{background:#141D26;color:#E6EDF3;border:1px solid var(--hair);box-shadow:0 18px 40px rgba(0,0,0,.55)}
  .leaflet-popup-content{margin:.7rem .85rem;font-size:13px}
  .leaflet-popup-close-button{color:#8ba0b3!important}

  .zone-chip{display:inline-flex;align-items:center;gap:.3rem;white-space:nowrap;font-size:10.5px;font-weight:600;
    padding:2px 7px;border-radius:999px;transform:translate(-50%,-50%);background:rgba(10,15,20,.78);
    border:1px solid var(--hair);color:#D7E3ED;box-shadow:0 4px 14px rgba(0,0,0,.45)}
  .zone-chip i.sw{width:6px;height:6px;border-radius:99px;display:block}
  .zone-chip .badge{display:inline-grid;place-items:center;width:13px;height:13px;border-radius:99px;
    background:var(--warn);color:#1a1200;font-size:9px;font-weight:700;margin-left:2px}

  .pin{transform:translate(-50%,-100%);display:grid;place-items:center}
  .pin span{width:26px;height:26px;border-radius:999px;display:grid;place-items:center;background:#141D26;
    border:1.5px solid var(--warn);color:var(--warn);box-shadow:0 6px 18px rgba(0,0,0,.5)}
  .pin.drop{animation:drop .55s cubic-bezier(.22,1.2,.36,1)}
  @keyframes drop{0%{transform:translate(-50%,-260%) scale(.6);opacity:0}60%{opacity:1}100%{transform:translate(-50%,-100%) scale(1)}}
  .pulse{animation:pulse 1.9s ease-out infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(239,68,68,.45)}70%{box-shadow:0 0 0 12px rgba(239,68,68,0)}100%{box-shadow:0 0 0 0 rgba(239,68,68,0)}}

  .scroll::-webkit-scrollbar{width:8px;height:8px}
  .scroll::-webkit-scrollbar-thumb{background:#243444;border-radius:99px}
  .scroll::-webkit-scrollbar-track{background:transparent}

  .field{width:100%;background:rgba(10,15,20,.6);border:1px solid var(--hair);border-radius:.6rem;
    padding:.55rem .7rem;font-size:13px;color:#E6EDF3;outline:none}
  .field:focus-visible{border-color:var(--brand);box-shadow:0 0 0 3px rgba(34,211,238,.18)}
  select.field{appearance:none}
  select.field option{background:#0E151C}
  :focus-visible{outline:2px solid var(--brand);outline-offset:2px}

  .seg{display:flex;padding:3px;gap:3px;background:rgba(10,15,20,.6);border:1px solid var(--hair);border-radius:.7rem}
  .seg button{flex:1;padding:.45rem .5rem;border-radius:.5rem;font-size:12.5px;font-weight:600;color:#8FA3B5;transition:.18s}
  .seg button[aria-pressed="true"]{background:#1F2D3B;color:#E6EDF3;box-shadow:inset 0 0 0 1px var(--hair)}

  .chip{display:flex;align-items:center;gap:.5rem;width:100%;text-align:left;padding:.5rem .6rem;border-radius:.6rem;
    border:1px solid var(--hair);background:rgba(10,15,20,.45);font-size:12.5px;color:#93A6B8;transition:.18s}
  .chip[aria-pressed="true"]{color:#E6EDF3;background:rgba(34,211,238,.09);border-color:rgba(34,211,238,.38)}
  .chip .dot{width:7px;height:7px;border-radius:99px;background:#33465a;flex:none}
  .chip[aria-pressed="true"] .dot{background:var(--brand);box-shadow:0 0 0 3px rgba(34,211,238,.18)}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;border-radius:.6rem;font-weight:600;font-size:13px;padding:.6rem .85rem;transition:.18s}
  .btn-primary{background:var(--brand);color:#04141a}
  .btn-primary:hover{filter:brightness(1.08)}
  .btn-ghost{border:1px solid var(--hair);color:#C4D3E0;background:rgba(10,15,20,.4)}
  .btn-ghost:hover{background:#1B2733}

  /* Live-sync indicator */
  .sync{display:flex;align-items:center;gap:.45rem;font-size:11.5px;padding:.35rem .6rem;border-radius:.55rem;
    border:1px solid var(--hair);background:rgba(10,15,20,.45);color:#9FB3C4}
  .sync .led{width:7px;height:7px;border-radius:99px;background:#64748B;flex:none}
  .sync[data-s="live"] .led{background:var(--safe);animation:breathe 2.2s ease-in-out infinite}
  .sync[data-s="connecting"] .led{background:var(--warn);animation:breathe 1s ease-in-out infinite}
  .sync[data-s="local"] .led{background:var(--brand)}
  .sync[data-s="error"] .led{background:var(--risk)}
  @keyframes breathe{0%,100%{opacity:1;box-shadow:0 0 0 0 currentColor}50%{opacity:.45;box-shadow:0 0 0 4px rgba(16,185,129,.12)}}

  .panel{transition:transform .28s cubic-bezier(.4,0,.2,1)}
  @media (max-width:1023px){
    #sidebar{position:absolute;z-index:40;top:0;bottom:0;left:0;width:min(88vw,22rem);transform:translateX(-102%)}
    #sidebar.open{transform:translateX(0)}
    #drawer{position:absolute;z-index:40;top:0;bottom:0;right:0;width:min(92vw,23rem);transform:translateX(102%)}
    #drawer.open{transform:translateX(0)}
  }
  @media (min-width:1024px){ #drawer{width:23rem;transform:translateX(0);display:none} #drawer.open{display:flex} }
  @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body class="font-sans">

<div class="relative h-screen w-screen flex flex-col">

  <!-- ══ HEADER ══ -->
  <header class="relative z-30 glass flex items-center gap-3 px-3 sm:px-4 py-2.5 border-b" style="border-bottom-color:var(--hair)">
    <button id="btnSidebar" class="lg:hidden btn btn-ghost !p-2" aria-label="Open controls">
      <i data-lucide="panel-left" class="w-4 h-4"></i>
    </button>

    <div class="flex items-center gap-2.5 min-w-0">
      <div class="w-9 h-9 rounded-xl grid place-items-center flex-none"
           style="background:linear-gradient(145deg,rgba(34,211,238,.22),rgba(16,185,129,.16));border:1px solid var(--hair)">
        <i data-lucide="shield-check" class="w-[18px] h-[18px]" style="color:var(--brand)"></i>
      </div>
      <div class="min-w-0">
        <h1 class="font-display font-bold text-[15px] sm:text-[17px] leading-tight truncate">Madurai Safety Navigator</h1>
        <p class="text-[11px] text-slate-400 leading-tight truncate hidden sm:block">Live zone ratings, decaying incident heat and safer routes</p>
      </div>
    </div>

    <div class="ml-auto flex items-center gap-2">
      <div id="syncBadge" class="sync" data-s="connecting" title="Database connection status">
        <span class="led"></span><span id="syncText">Connecting…</span>
      </div>
      <div class="hidden lg:flex items-center gap-2 text-[11.5px] text-slate-400 px-2.5 py-1.5 rounded-lg hair border" style="background:rgba(10,15,20,.4)">
        <span id="clock">—</span><span class="opacity-40">|</span><span id="modeLabel">Day map</span>
      </div>
      <button id="btnReport" class="btn btn-primary">
        <i data-lucide="siren" class="w-4 h-4"></i><span class="hidden sm:inline">Report an issue</span>
      </button>
    </div>
  </header>

  <div class="relative flex-1 flex overflow-hidden">

    <!-- ══ SIDEBAR ══ -->
    <aside id="sidebar" class="panel glass w-[21rem] flex-none flex flex-col border-r" style="border-right-color:var(--hair)">
      <div class="flex items-center justify-between px-4 py-3 border-b" style="border-bottom-color:var(--hair)">
        <h2 class="font-display font-bold text-[13.5px]">Map controls</h2>
        <button id="closeSidebar" class="lg:hidden text-slate-400 hover:text-white" aria-label="Close controls">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <div class="scroll flex-1 overflow-y-auto px-4 py-4 space-y-6">

        <section>
          <h3 class="font-display font-bold text-[13px] mb-2 flex items-center gap-2">
            <i data-lucide="sun-moon" class="w-4 h-4" style="color:var(--brand)"></i>When are you travelling?
          </h3>
          <div class="seg" id="timeSeg" role="group" aria-label="Time of day">
            <button data-time="day" aria-pressed="true">Daytime</button>
            <button data-time="night" aria-pressed="false">After dark</button>
            <button data-time="auto" aria-pressed="true">Auto</button>
          </div>
          <p id="timeNote" class="text-[11.5px] text-slate-400 mt-2 leading-relaxed"></p>
        </section>

        <section>
          <h3 class="font-display font-bold text-[13px] mb-2 flex items-center gap-2">
            <i data-lucide="route" class="w-4 h-4" style="color:var(--safe)"></i>Safe route finder
          </h3>
          <div class="space-y-2">
            <label class="block"><span class="text-[11px] text-slate-400">Starting from</span>
              <select id="fromSel" class="field mt-1"></select></label>
            <label class="block"><span class="text-[11px] text-slate-400">Going to</span>
              <select id="toSel" class="field mt-1"></select></label>
            <div class="flex gap-2">
              <button id="btnRoute" class="btn btn-primary flex-1"><i data-lucide="navigation" class="w-4 h-4"></i>Compare routes</button>
              <button id="btnClearRoute" class="btn btn-ghost !px-3" aria-label="Clear routes"><i data-lucide="eraser" class="w-4 h-4"></i></button>
            </div>
          </div>
          <div id="routeResult" class="mt-3"></div>
        </section>

        <section>
          <h3 class="font-display font-bold text-[13px] mb-2 flex items-center gap-2">
            <i data-lucide="radio" class="w-4 h-4" style="color:var(--warn)"></i>Live area alerts
          </h3>
          <div id="alertFeed" class="space-y-1.5"></div>
        </section>

        <section>
          <h3 class="font-display font-bold text-[13px] mb-2 flex items-center gap-2">
            <i data-lucide="layers" class="w-4 h-4" style="color:var(--warn)"></i>What to show on the map
          </h3>
          <div class="grid gap-1.5">
            <button class="chip" data-layer="heat" aria-pressed="true"><span class="dot"></span>Crime heat overlay</button>
            <button class="chip" data-layer="zones" aria-pressed="true"><span class="dot"></span>Locality safety zones</button>
            <button class="chip" data-layer="labels" aria-pressed="true"><span class="dot"></span>Area name labels</button>
            <button class="chip" data-layer="havens" aria-pressed="false"><span class="dot"></span>Police, hospitals &amp; safe havens</button>
            <button class="chip" data-layer="reports" aria-pressed="true"><span class="dot"></span>Community reports</button>
          </div>
        </section>

        <section>
          <h3 class="font-display font-bold text-[13px] mb-2 flex items-center gap-2">
            <i data-lucide="filter" class="w-4 h-4" style="color:var(--risk)"></i>Risk types in the heat map
          </h3>
          <div class="grid gap-1.5">
            <button class="chip" data-cat="theft" aria-pressed="true"><span class="dot"></span>Pickpocketing &amp; petty theft</button>
            <button class="chip" data-cat="isolation" aria-pressed="true"><span class="dot"></span>Isolated stretches after dark</button>
            <button class="chip" data-cat="women" aria-pressed="true"><span class="dot"></span>Women's safety concerns</button>
            <button class="chip" data-cat="traffic" aria-pressed="true"><span class="dot"></span>Accident-prone junctions</button>
          </div>
        </section>

        <section>
          <h3 class="font-display font-bold text-[13px] mb-2 flex items-center gap-2">
            <i data-lucide="list-tree" class="w-4 h-4" style="color:var(--brand)"></i>Localities, safest first
          </h3>
          <div id="zoneList" class="space-y-1.5"></div>
        </section>

        <section>
          <h3 class="font-display font-bold text-[13px] mb-2 flex items-center gap-2">
            <i data-lucide="megaphone" class="w-4 h-4" style="color:var(--warn)"></i>Community reports
            <span id="reportCount" class="ml-auto text-[11px] font-sans font-medium text-slate-400"></span>
          </h3>
          <div id="feed" class="space-y-1.5"></div>
        </section>

        <p class="text-[10.5px] text-slate-500 leading-relaxed pt-2 border-t" style="border-top-color:var(--hair)">
          Baseline zone scores are illustrative sample data, adjusted live by community reports from the last 7 days.
          In an emergency dial 100 (police), 108 (ambulance) or 1091 (women's helpline).
        </p>
      </div>
    </aside>

    <!-- ══ MAP ══ -->
    <main class="relative flex-1">
      <div id="map"></div>

      <div class="absolute left-3 bottom-6 z-[500] glass rounded-xl px-3 py-2.5 hidden sm:block">
        <p class="font-display font-bold text-[11.5px] mb-1.5">Safety tiers</p>
        <div class="space-y-1 text-[11.5px] text-slate-300">
          <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-sm" style="background:var(--safe)"></span>Safe and busy</div>
          <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-sm" style="background:var(--warn)"></span>Stay aware</div>
          <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-sm" style="background:var(--risk)"></span>Higher risk</div>
