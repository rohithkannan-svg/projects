/* ═══ 3. TIME, DECAY & LIVE SCORING ══════════════════════════════════════ */

/* Madurai local time regardless of the viewer's own timezone */
function istNow(){
  const d = new Date();
  return new Date(d.getTime() + (330 + d.getTimezoneOffset()) * 60000);
}
function autoMode(){ const h = istNow().getHours(); return (h >= 19 || h < 6) ? 'night' : 'day'; }

const HRS = 3600000;
const halfLife = (ageMs, hrs) => Math.pow(0.5, (ageMs/HRS)/hrs);

const decay = {
  heat(r){                                   // 0 → no contribution
    const age = Date.now() - r.created_at;
    if(age > CONFIG.heatCutoffHrs*HRS) return 0;
    return halfLife(age, CONFIG.heatHalfLifeHrs);
  },
  score(r){
    const age = Date.now() - r.created_at;
    if(age > CONFIG.scoreWindowDays*24*HRS) return 0;
    return halfLife(age, CONFIG.scoreHalfLifeHrs);
  }
};

/* Rating penalty a locality has earned from recent community reports */
function penaltyFor(zoneId){
  let p = 0;
  for(const r of state.reports){
    if(r.locality !== zoneId) continue;
    const w = decay.score(r);
    if(!w) continue;
    p += w * (r.severity || 2) * 0.16;
  }
  return Math.min(CONFIG.maxPenalty, p);
}

/* Extra heat a locality carries right now, 0–1 */
function reportHeatFor(zoneId){
  let h = 0;
  for(const r of state.reports){
    if(r.locality !== zoneId) continue;
    const dim = CAT_MAP[r.category] || 'theft';
    if(!state.cats[dim]) continue;
    h += decay.heat(r) * (r.severity || 2) * 0.13;
  }
  return Math.min(1, h);
}

const baseScore = z => state.time==='day' ? z.day : z.night;
function liveScore(z){
  return Math.max(0.8, Math.min(5, baseScore(z) - penaltyFor(z.id)));
}

const tier  = s => s>=4.2 ? 'safe' : s>=3.2 ? 'warn' : 'risk';
const COLOR = { safe:'#10B981', warn:'#F59E0B', risk:'#EF4444' };
const tierWord = { safe:'Safe and busy', warn:'Stay aware', risk:'Higher risk' };

function catRisk(z){
  const on = Object.keys(state.cats).filter(k=>state.cats[k]);
  let v = 0;
  if(on.length){
    v = on.reduce((s,k)=>s+z.risk[k],0)/on.length;
    if(state.time==='night'){
      v = Math.min(1, v*0.72 + (z.risk.isolation*0.55 + z.risk.women*0.35) * ((state.cats.isolation||state.cats.women)?0.75:0.2));
    }
  }
  return Math.min(1, v + reportHeatFor(z.id)*0.55);
}

/* ═══ 4. SYNC LAYER — Supabase, or local fallback ════════════════════════ */
const sync = (() => {
  const CONFIGURED = !/^YOUR_/.test(SUPABASE_URL) && !/^YOUR_/.test(SUPABASE_ANON_KEY);
  const LS_KEY = 'madurai.reports.v2';
  let db = null, channel = null, bc = null, onInsert = ()=>{};

  const normalise = row => ({
    id: row.id,
    created_at: typeof row.created_at === 'number' ? row.created_at : new Date(row.created_at).getTime(),
    locality: row.locality,
    latitude: Number(row.latitude),
    longitude: Number(row.longitude),
    category: row.category,
    description: row.description || '',
    severity: Number(row.severity) || 2
  });

  /* ---- local transport ------------------------------------------------ */
  const local = {
    read(){
      try { return JSON.parse(localStorage.getItem(LS_KEY) || '[]').map(normalise); }
      catch { return []; }
    },
    write(rows){
      try { localStorage.setItem(LS_KEY, JSON.stringify(rows)); } catch {}
    }
  };

  function seedIfEmpty(){
    if(local.read().length) return;
    const now = Date.now();
    local.write([
      { id:'s1', created_at:now-1000*60*42,    locality:'othakadai',    latitude:9.9542, longitude:78.1761,
        category:'Poor street lighting', severity:2, description:'Four lights out on the stretch before the bridge. Pitch dark by 19:30.' },
      { id:'s2', created_at:now-1000*60*60*3,  locality:'goripalayam',  latitude:9.9301, longitude:78.1258,
        category:'Traffic hazard', severity:3, description:'Sand spill near the flyover ramp, two-wheelers skidding.' },
      { id:'s3', created_at:now-1000*60*60*9,  locality:'mattuthavani', latitude:9.9455, longitude:78.1583,
        category:'Suspicious activity', severity:3, description:'Group loitering around the far parking lot, approaching solo passengers.' },
      { id:'s4', created_at:now-1000*60*60*30, locality:'ringsouth',    latitude:9.8641, longitude:78.0902,
        category:'Traffic hazard', severity:2, description:'Lorry broken down on the shoulder, no reflectors.' }
    ]);
  }

  async function start(handler){
    onInsert = handler;

    if(!CONFIGURED){
      seedIfEmpty();
      // BroadcastChannel gives genuine live multi-client behaviour across tabs.
      try {
        bc = new BroadcastChannel('madurai-safety');
        bc.onmessage = e => { if(e.data && e.data.type==='report') onInsert(normalise(e.data.row)); };
      } catch {}
      setSync('local', 'Local mode');
      return local.read();
    }

    try {
      setSync('connecting', 'Connecting…');
      db = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, { realtime:{ params:{ eventsPerSecond:5 } } });

      const since = new Date(Date.now() - CONFIG.scoreWindowDays*24*HRS).toISOString();
      const { data, error } = await db.from('reports').select('*').gte('created_at', since).order('created_at',{ascending:false}).limit(500);
      if(error) throw error;

      channel = db.channel('reports-live')
        .on('postgres_changes', { event:'INSERT', schema:'public', table:'reports' },
            payload => onInsert(normalise(payload.new)))
        .subscribe(status => {
          if(status==='SUBSCRIBED')            setSync('live','Live syncing');
          else if(status==='CHANNEL_ERROR' ||
                  status==='TIMED_OUT')        setSync('error','Reconnecting…');
          else if(status==='CLOSED')           setSync('error','Disconnected');
          else                                 setSync('connecting','Connecting…');
        });

      return (data||[]).map(normalise);
    } catch (err) {
      console.warn('[sync] Supabase unavailable, falling back to local mode:', err && err.message);
      seedIfEmpty();
      setSync('error','Offline — local only');
      return local.read();
    }
  }

  async function insert(report){
    if(!CONFIGURED || !db){
      const rows = local.read(); rows.unshift(report); local.write(rows.slice(0,500));
      try { bc && bc.postMessage({ type:'report', row:report }); } catch {}
      return { ok:true, row:report, echo:true };   // echo: caller must add it locally
    }
    const { data, error } = await db.from('reports').insert({
      locality:    report.locality,
      latitude:    report.latitude,
      longitude:   report.longitude,
      category:    report.category,
      description: report.description,
      severity:    report.severity
    }).select().single();

    if(error) return { ok:false, error };
    // Realtime will echo this INSERT back to us, so don't add it twice.
    return { ok:true, row:normalise(data), echo:false };
  }

  return { start, insert, get configured(){ return CONFIGURED; } };
})();

function setSync(s, label){
  state.sync = s;
  const b = document.getElementById('syncBadge');
  if(!b) return;
  b.dataset.s = s;
  document.getElementById('syncText').textContent = label;
  b.title = s==='local'
    ? 'No database configured — reports persist in this browser and sync across your open tabs'
    : s==='live' ? 'Connected to Supabase realtime' : label;
}

