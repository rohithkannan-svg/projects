          <button type="button" data-sev="2" aria-pressed="true">Concerning</button>
          <button type="button" data-sev="3" aria-pressed="false">Urgent</button>
        </div>
      </div>

      <label class="block"><span class="text-[11.5px] text-slate-400">Nearest area</span>
        <select id="rZone" class="field mt-1"></select></label>

      <div>
        <span class="text-[11.5px] text-slate-400">Exact spot</span>
        <div class="flex gap-2 mt-1">
          <input id="rLat" class="field" placeholder="Latitude" inputmode="decimal" required />
          <input id="rLng" class="field" placeholder="Longitude" inputmode="decimal" required />
        </div>
        <button type="button" id="btnPick" class="btn btn-ghost w-full mt-2"><i data-lucide="map-pin" class="w-4 h-4"></i>Pick the spot on the map</button>
      </div>

      <label class="block"><span class="text-[11.5px] text-slate-400">Anything else worth knowing?</span>
        <textarea id="rNote" rows="3" class="field mt-1" placeholder="e.g. Three street lights out near the subway entrance, dark after 8pm."></textarea></label>

      <div class="flex items-center gap-2 pt-1">
        <button type="submit" id="rSubmit" class="btn btn-primary flex-1"><i data-lucide="send" class="w-4 h-4"></i>Submit report</button>
        <button type="button" id="cancelReport" class="btn btn-ghost">Cancel</button>
      </div>
      <p class="text-[10.5px] text-slate-500">Reports fade out of the heat map after 24 hours and stop affecting ratings after 7 days. In an emergency call 100 first.</p>
    </form>
  </div>
</div>

<script>
/* ═══════════════════════════════════════════════════════════════════════════
   MADURAI SAFETY NAVIGATOR — v2

   ── QUICK SETUP ─────────────────────────────────────────────────────────────
   The app runs out of the box with no backend (local mode: reports persist in
   localStorage and sync live across open tabs via BroadcastChannel).
   To go multi-user, create a Supabase project and paste the two values below.

   1. Run this SQL in the Supabase SQL editor:

        create table public.reports (
          id          uuid primary key default gen_random_uuid(),
          created_at  timestamptz      not null default now(),
          locality    text             not null,   -- zone id, e.g. 'mattuthavani'
          latitude    double precision not null,
          longitude   double precision not null,
          category    text             not null,   -- e.g. 'Poor street lighting'
          description text,
          severity    smallint         not null default 2   -- 1 minor, 2 concerning, 3 urgent
        );

        create index reports_created_at_idx on public.reports (created_at desc);

        -- Anonymous community reporting: open read + insert, no updates/deletes.
        alter table public.reports enable row level security;

        create policy "public read"   on public.reports for select using (true);
        create policy "public insert" on public.reports for insert with check (true);

   2. Enable realtime on the table:
        alter publication supabase_realtime add table public.reports;

   3. Paste your project URL and anon key into SUPABASE_URL / SUPABASE_ANON_KEY.
      The anon key is safe in client code as long as RLS is on, as above.

   ── ARCHITECTURE NOTES ──────────────────────────────────────────────────────
   • sync.*        one interface, two transports (Supabase | local BroadcastChannel)
   • decay.*       TTL weighting: heat half-life 6h, hard cutoff 24h;
                   score influence half-life 48h over a rolling 7-day window
   • liveScore()   baseline score − community penalty, recomputed on every tick
   • feeds.*       simulated RSS/traffic poller driving per-locality alert badges
   ═══════════════════════════════════════════════════════════════════════════ */

const SUPABASE_URL      = 'YOUR_SUPABASE_URL';        // e.g. https://abcdefgh.supabase.co
const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';   // public anon key

const CONFIG = {
  heatHalfLifeHrs:   6,     // how fast a report's heat contribution halves
  heatCutoffHrs:     24,    // dropped from the heat map entirely after this
  scoreHalfLifeHrs:  48,    // slower decay for the rating penalty
  scoreWindowDays:   7,     // rolling window for rating adjustment
  maxPenalty:        1.7,   // most a locality's rating can fall from reports
  feedPollMs:        45000, // simulated news/traffic poll interval
  tickMs:            60000  // recompute decay + auto day/night every minute
