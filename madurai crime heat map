          <option value="Poor street lighting">Poor street lighting</option>
          <option value="Suspicious activity">Suspicious activity</option>
          <option value="Traffic hazard">Traffic hazard or blocked road</option>
          <option value="Harassment">Harassment or eve-teasing</option>
          <option value="Theft / snatching">Theft or chain snatching</option>
          <option value="Stray animal risk">Stray animal risk</option>
        </select></label>

      <div>
        <span class="text-[11.5px] text-slate-400">How serious is it?</span>
