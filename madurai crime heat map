  const ICON = { traffic:'traffic-cone', police:'shield', weather:'cloud-fog', event:'users' };
  const TTL = 1000*60*8;

  function poll(){
    const pick = POOL[Math.floor(Math.random()*POOL.length)];
    if(!state.alerts.some(a => a.zone===pick.zone && a.text===pick.text)){
      state.alerts.unshift({ ...pick, t:Date.now() });
    }
    prune();
    renderAlerts(); drawZones(); renderZoneList();
    if(state.active) openZone(state.active, true);
  }
  function prune(){
    const cut = Date.now()-TTL;
    state.alerts = state.alerts.filter(a => a.t > cut).slice(0,10);
  }
  function forZone(id){ return state.alerts.filter(a=>a.zone===id); }

  function start(){
    // Seed two so the panel is never empty on first paint.
    state.alerts = [
      { ...POOL[0], t:Date.now()-1000*60*4 },
      { ...POOL[2], t:Date.now()-1000*60*2 }
    ];
    renderAlerts();
    setInterval(poll, CONFIG.feedPollMs);
  }
  return { start, forZone, prune, ICON };
})();

/* ═══ 6. MAP ═════════════════════════════════════════════════════════════ */
let map, zoneLayer, labelLayer, havenLayer, reportLayer, routeLayer, heatLayer=null;

function initMap(){
  map = L.map('map', { center:MADURAI, zoom:13, zoomControl:false });
  L.control.zoom({ position:'bottomright' }).addTo(map);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom:19, attribution:'&copy; OpenStreetMap contributors · community safety data'
  }).addTo(map);

  zoneLayer   = L.layerGroup().addTo(map);
  labelLayer  = L.layerGroup().addTo(map);
  havenLayer  = L.layerGroup();
  reportLayer = L.layerGroup().addTo(map);
  routeLayer  = L.layerGroup().addTo(map);

  map.on('click', e=>{
    if(!state.picking) return;
    $('rLat').value = e.latlng.lat.toFixed(5);
    $('rLng').value = e.latlng.lng.toFixed(5);
    let best=null, bd=Infinity;
    ZONES.forEach(z=>{ const d=dist([e.latlng.lat,e.latlng.lng], z.c); if(d<bd){bd=d;best=z.id;} });
    if(best) $('rZone').value = best;
    cancelPick();
    toast('Location added to your report');
  });
}

function rnd(seed){ const x = Math.sin(seed*12.9898)*43758.5453; return x - Math.floor(x); }

function blobFor(z,i){
  const pts=[], n=11, latm=z.r/111320, lngm=z.r/(111320*Math.cos(z.c[0]*Math.PI/180));
  for(let k=0;k<n;k++){
    const a=(k/n)*Math.PI*2, wob=0.72+rnd(i*31+k*7)*0.5;
    pts.push([ z.c[0]+Math.sin(a)*latm*wob, z.c[1]+Math.cos(a)*lngm*wob ]);
  }
  return pts;
}

function drawZones(){
  if(!zoneLayer) return;
  zoneLayer.clearLayers(); labelLayer.clearLayers();
  ZONES.forEach((z,i)=>{
    const s = liveScore(z), t = tier(s), col = COLOR[t];
    const dropped = baseScore(z) - s;
    const poly = L.polygon(blobFor(z,i+1), {
      color:col, weight:1.6, opacity:.85, fillColor:col,
      fillOpacity: state.active===z.id ? .34 : .15
    });
    poly.on('click', ()=>openZone(z.id));
    poly.on('mouseover', ()=>poly.setStyle({fillOpacity:.3, weight:2.4}));
    poly.on('mouseout',  ()=>poly.setStyle({fillOpacity: state.active===z.id?.34:.15, weight:1.6}));
    poly.bindTooltip(`${z.name} · ${s.toFixed(1)}/5${dropped>0.05?` (↓${dropped.toFixed(1)} from live reports)`:''}`,
                     { direction:'top', opacity:.95 });
    zoneLayer.addLayer(poly);

    const alerts = feeds.forZone(z.id).length;
    const chip = L.marker(z.c, { icon: L.divIcon({ className:'', iconSize:[0,0], html:
      `<div class="zone-chip"><i class="sw" style="background:${col}"></i>${escHtml(z.name)}${
        alerts?`<span class="badge">${alerts}</span>`:''}</div>` }) });
    chip.on('click', ()=>openZone(z.id));
    labelLayer.addLayer(chip);
  });
}

function drawHeat(){
  if(heatLayer){ map.removeLayer(heatLayer); heatLayer=null; }
  if(!state.layers.heat) return;
  const pts=[];
  ZONES.forEach((z,i)=>{
    const v = catRisk(z);
    if(v<0.05) return;
    const latm=z.r/111320, lngm=z.r/(111320*Math.cos(z.c[0]*Math.PI/180));
    const n = 22+Math.round(v*24);
    for(let k=0;k<n;k++){
      const a=rnd(i*97+k*3)*Math.PI*2, d=Math.sqrt(rnd(i*13+k*11))*0.95;
      pts.push([ z.c[0]+Math.sin(a)*latm*d, z.c[1]+Math.cos(a)*lngm*d, Math.max(.12, v*(1-d*0.45)) ]);
    }
  });
  // Live reports punch their own hot spots, weighted by TTL decay.
  state.reports.forEach(r=>{
    const w = decay.heat(r);
    if(!w) return;
    const dim = CAT_MAP[r.category] || 'theft';
    if(!state.cats[dim]) return;
    pts.push([ r.latitude, r.longitude, Math.min(1, w*(r.severity||2)*0.34) ]);
  });

  heatLayer = L.heatLayer(pts, {
    radius:34, blur:26, maxZoom:16, minOpacity:.25,
    gradient:{ 0.25:'#10B981', 0.5:'#F59E0B', 0.72:'#F97316', 1:'#EF4444' }
  }).addTo(map);
  if(heatLayer._canvas) heatLayer._canvas.style.mixBlendMode='screen';
}

const HAVEN_ICON = { police:'shield', hospital:'cross', hub:'lamp' };
function drawHavens(){
