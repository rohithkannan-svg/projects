}

/* ═══ 7. ROUTING ═════════════════════════════════════════════════════════ */
const ADJ = {};
ZONES.forEach(z=>ADJ[z.id]=[]);
EDGES.forEach(([a,b])=>{
  if(!byId[a]||!byId[b]) return;
  const d = dist(byId[a].c, byId[b].c);
  ADJ[a].push({to:b,d}); ADJ[b].push({to:a,d});
});

function dist(a,b){
  const R=6371, dLat=(b[0]-a[0])*Math.PI/180, dLng=(b[1]-a[1])*Math.PI/180;
  const h = Math.sin(dLat/2)**2 + Math.cos(a[0]*Math.PI/180)*Math.cos(b[0]*Math.PI/180)*Math.sin(dLng/2)**2;
  return 2*R*Math.asin(Math.sqrt(h));
}

function dijkstra(from,to,weight){
  const D={}, P={}, seen=new Set();
  ZONES.forEach(z=>D[z.id]=Infinity); D[from]=0;
  while(true){
    let u=null,best=Infinity;
    for(const id in D) if(!seen.has(id)&&D[id]<best){ best=D[id]; u=id; }
    if(u===null||u===to) break;
    seen.add(u);
    ADJ[u].forEach(e=>{ const alt=D[u]+weight(u,e.to,e.d); if(alt<D[e.to]){ D[e.to]=alt; P[e.to]=u; } });
  }
  if(D[to]===Infinity) return null;
  const path=[to]; while(path[0]!==from){ const p=P[path[0]]; if(!p) return null; path.unshift(p); }
  return path;
}

const routeStats = path => ({
  km: path.slice(1).reduce((s,id,i)=>s+dist(byId[path[i]].c, byId[id].c),0),
  safety: path.reduce((s,id)=>s+liveScore(byId[id]),0)/path.length,
  alerts: path.reduce((s,id)=>s+feeds.forZone(id).length,0)
});

function findRoutes(){
  const from=fromSel.value, to=toSel.value;
  routeLayer.clearLayers();
  if(from===to){ routeResult.innerHTML = note('Pick two different places to compare a route.'); return; }

  const fast = dijkstra(from,to,(a,b,d)=>d);
  const safe = dijkstra(from,to,(a,b,d)=>{
    const risk = (5 - (liveScore(byId[a])+liveScore(byId[b]))/2)/5;
    const alertPenalty = (feeds.forZone(b).length)*0.12;
    return d * (1 + risk*3.2 + alertPenalty);
  });
  if(!fast){ routeResult.innerHTML = note('No mapped road link between those two areas in this data set.'); return; }

  const fs=routeStats(fast), ss=routeStats(safe), same = fast.join()===safe.join();
  if(!same) drawRoute(fast,'#64748B','Fastest route',5,'8 8');
  drawRoute(safe,'#10B981','Safest route',6,null);
  map.fitBounds(L.latLngBounds([...fast,...safe].map(id=>byId[id].c)), { padding:[70,70], maxZoom:14 });

  const detour = fs.km>0 ? Math.round(((ss.km-fs.km)/fs.km)*100) : 0;
  routeResult.innerHTML = `
    <div class="rounded-xl border hair overflow-hidden" style="background:rgba(10,15,20,.45)">
      <div class="px-3 py-2.5 border-b" style="border-bottom-color:var(--hair)">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 rounded-sm" style="background:var(--safe)"></span>
          <span class="font-display font-bold text-[12.5px]">Safest route</span>
          <span class="ml-auto text-[11.5px] text-slate-400">${ss.km.toFixed(1)} km</span>
        </div>
        <p class="text-[11.5px] text-slate-400 leading-relaxed">${safe.map(id=>escHtml(byId[id].name)).join(' → ')}</p>
        <p class="text-[11.5px] mt-1.5" style="color:var(--safe)">Live rating ${ss.safety.toFixed(1)}/5 ${
          state.time==='night'?'after dark':'by day'}${ss.alerts?` · ${ss.alerts} active alert${ss.alerts>1?'s':''} en route`:''}</p>
      </div>
      ${ same ? `<div class="px-3 py-2.5 text-[11.5px] text-slate-400 leading-relaxed">
          The quickest way is also the safest right now — no trade-off to make.</div>`
      : `<div class="px-3 py-2.5">
          <div class="flex items-center gap-2 mb-1">
            <span class="w-2.5 h-2.5 rounded-sm" style="background:#64748B"></span>
            <span class="font-display font-bold text-[12.5px] text-slate-300">Fastest route</span>
            <span class="ml-auto text-[11.5px] text-slate-400">${fs.km.toFixed(1)} km</span>
          </div>
          <p class="text-[11.5px] text-slate-400 leading-relaxed">${fast.map(id=>escHtml(byId[id].name)).join(' → ')}</p>
          <p class="text-[11.5px] text-slate-400 mt-1.5">Live rating ${fs.safety.toFixed(1)}/5</p>
        </div>
        <div class="px-3 py-2.5 border-t text-[11.5px] leading-relaxed" style="border-top-color:var(--hair);background:rgba(245,158,11,.08);color:#FBBF24">
          <strong class="font-semibold">The trade-off:</strong> the safer line adds about ${Math.max(detour,1)}% distance
          and gains ${(ss.safety-fs.safety).toFixed(1)} rating points by staying on lit main belts.
        </div>`}
    </div>`;
}

function drawRoute(path,color,label,weight,dash){
  const pts = path.map(id=>byId[id].c);
  L.polyline(pts,{color,weight:weight+5,opacity:.14}).addTo(routeLayer);
  L.polyline(pts,{color,weight,opacity:.95,dashArray:dash,lineCap:'round',lineJoin:'round'})
   .addTo(routeLayer).bindTooltip(label,{sticky:true});
  pts.forEach((p,i)=>{
    const end = i===0||i===pts.length-1;
    L.circleMarker(p,{radius:end?7:4.5,color,weight:2.5,fillColor:end?color:'#0A0F14',fillOpacity:1})
     .addTo(routeLayer).bindTooltip(byId[path[i]].name,{direction:'top'});
  });
}

const note = t => `<p class="text-[11.5px] text-slate-400 leading-relaxed px-1">${t}</p>`;

/* ═══ 8. DRAWER ══════════════════════════════════════════════════════════ */
function stars(v){
  const full=Math.floor(v), half=v-full>=.5;
  let h='';
  for(let i=0;i<5;i++){
    const on=i<full, hf=i===full&&half;
    h += `<i data-lucide="${hf?'star-half':'star'}" class="w-3.5 h-3.5" style="${on||hf?'color:#FBBF24;fill:#FBBF24':'color:#33465a'}"></i>`;
  }
  return h;
}

